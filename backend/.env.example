MONGO_URL=mongodb://localhost:27017
DB_NAME=elitereserve

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081

# Admin account, created on first start if it does not exist (min. 12 characters).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Local development only: seeds demo accounts, the sample fleet and sample activity.
SEED_DEMO_DATA=false

# No payment provider is integrated yet. When true, wallet top-ups credit the balance
# without charging anyone. Defaults to the value of SEED_DEMO_DATA.
# DEMO_PAYMENTS=false
# WELCOME_WALLET_CREDIT=0

# Monthly marketing spend (AUD) used to calculate CAC on the admin Revenue screen.
# MARKETING_SPEND_MONTHLY=

# Approve host KYC automatically instead of waiting for an admin. Defaults to SEED_DEMO_DATA.
# AUTO_APPROVE_VENDOR_KYC=false
